<section class="ops-banner ops-banner-top mb-3" aria-label="Dashboard health">
    <div class="ops-banner-item">
        <span class="dot ok"></span>
        <strong>Overall Health</strong>
        <span>@Snapshot.RenderStatus</span>
        <small class="ops-subtitle">Alert state: @Snapshot.AlertState · owner: @Snapshot.ActionOwner</small>
    </div>
    <div class="ops-banner-item">
        <span class="dot bad"></span>
        <strong>DDA Alerts</strong>
        <span>@Snapshot.Model.Alerts.Count</span>
        <small class="ops-subtitle">@Snapshot.Summaries.QueueState</small>
    </div>
    <div class="ops-banner-item ops-banner-split">
        <span class="dot warn"></span>
        <strong>Maintenance Snapshot</strong>
        <div class="ops-split-metrics" aria-label="Maintenance ticket states">
            <div class="ops-split-item">
                <span class="ops-split-label">Inbox emails</span>
                <span class="ops-split-value">@Snapshot.MaintenanceOverview.InboxEmails</span>
            </div>
            <div class="ops-split-item">
                <span class="ops-split-label">To-do</span>
                <span class="ops-split-value">@Snapshot.MaintenanceOverview.Todo</span>
            </div>
            <div class="ops-split-item">
                <span class="ops-split-label">Worked on</span>
                <span class="ops-split-value">@Snapshot.MaintenanceOverview.WorkedOn</span>
            </div>
        </div>
    </div>
</section>

<section class="approval-strip mb-3" aria-label="Pending release approvals">
    <div class="approval-strip-title">Pending release approvals</div>
    <div class="approval-strip-body">
        @foreach (var approval in Snapshot.ReleaseApprovals)
        {
            <span class="breach-chip amber me-2 mb-2">@approval</span>
        }
    </div>
</section>

@if (Snapshot.WarningAnnouncements.Count > 0)
{
    <section class="critical-announcement mb-3" aria-live="assertive" aria-label="Critical announcements">
        <div class="critical-announcement-label"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><span>Warnings</span></div>
        <div class="critical-announcement-divider" aria-hidden="true"></div>
        <div class="critical-announcement-text">@string.Join(" • ", Snapshot.WarningAnnouncements.Select(x => x.Title))</div>
    </section>
}

@if (Snapshot.ShowFreezeBanner)
{
    <section class="freeze-announcement mb-3" aria-live="polite" aria-label="Freeze announcement">
        <div class="freeze-announcement-label"><i class="bi bi-snow" aria-hidden="true"></i><span>Freeze</span></div>
        <div class="freeze-announcement-divider" aria-hidden="true"></div>
        <div class="freeze-announcement-text">Releases to Prod are forbidden</div>
    </section>
}

@code {
    [Parameter, EditorRequired] public DashboardSnapshot Snapshot { get; set; } = default!;
}
