@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="@ClassName" style="@Style" @ref="_element"></div>

@code {
    [Parameter] public IReadOnlyList<object>? Data { get; set; }
    [Parameter] public object? Layout { get; set; }
    [Parameter] public object? Config { get; set; }
    [Parameter] public string? ClassName { get; set; }
    [Parameter] public string? Style { get; set; }

    private ElementReference _element;
    private IJSObjectReference? _module;
    private string? _renderFingerprint;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/plotlyInterop.js");
        }

        if (_module is null)
        {
            return;
        }

        var fingerprint = JsonSerializer.Serialize(new { Data, Layout, Config });
        if (!firstRender && fingerprint == _renderFingerprint)
        {
            return;
        }

        _renderFingerprint = fingerprint;
        await _module.InvokeVoidAsync("renderPlot", _element, Data, Layout, Config);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disposePlot", _element);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
