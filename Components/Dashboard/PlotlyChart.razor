@inject IJSRuntime JS

<div class="@ClassName" style="@Style" @ref="_element"></div>

@code {
    [Parameter] public IReadOnlyList<object>? Data { get; set; }
    [Parameter] public object? Layout { get; set; }
    [Parameter] public object? Config { get; set; }
    [Parameter] public string? ClassName { get; set; }
    [Parameter] public string? Style { get; set; }

    private ElementReference _element;
    private string? _renderFingerprint;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var fingerprint = JsonSerializer.Serialize(new { Data, Layout, Config });
        if (!firstRender && fingerprint == _renderFingerprint)
        {
            return;
        }

        _renderFingerprint = fingerprint;
        await JS.InvokeVoidAsync("plotlyInterop.renderPlot", _element, Data, Layout, Config);
    }
}
